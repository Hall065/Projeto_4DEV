# Supabase - público para uso no app
# URL: apenas a base (sem /rest/v1/)
EXPO_PUBLIC_SUPABASE_URL=https://nmaftnueudtwizccenrm.supabase.co
# Chave: Supabase Dashboard → Settings → API Keys → Publishable key (sb_publishable_...)
# ou legacy anon key (eyJ...). NÃO use service_role / secret no app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_COLE_SUA_CHAVE_AQUI

# Cloudinary - público apenas se usar upload unsigned
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=COLE_AQUI
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=COLE_AQUI

# Localização do SENAI Limeira / perímetro
EXPO_PUBLIC_SENAI_LATITUDE=-22.5648
EXPO_PUBLIC_SENAI_LONGITUDE=-47.4014
EXPO_PUBLIC_SENAI_RAIO_METROS=150

# Azure Translator
# NUNCA coloque a chave Azure em EXPO_PUBLIC_*: isso a inclui no bundle do app.
# Configure AZURE_TRANSLATOR_KEY, AZURE_TRANSLATOR_REGION e, opcionalmente,
# AZURE_TRANSLATOR_ENDPOINT nos Secrets das Supabase Edge Functions.
# Consulte doc/AZURE_TRANSLATOR_SUPABASE.md.

# Chatbot Groq - URL do backend Python seguro
# Web/local: http://localhost:8000
# Android Emulator: http://10.0.2.2:8000
EXPO_PUBLIC_CHATBOT_API_URL=http://localhost:8000

# Conta de teste (apenas desenvolvimento — ajuste para seu usuário no Supabase Auth)
EXPO_PUBLIC_DEV_TEST_EMAIL=seu.email@senai.br
EXPO_PUBLIC_DEV_TEST_PASSWORD=sua_senha_de_teste
EXPO_PUBLIC_DEV_TEST_LABEL=Conta de teste

# Variáveis privadas - NÃO USAR NO EXPO PUBLIC
# Devem ficar no ambiente do Supabase Edge Functions ou backend seguro
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=COLE_AQUI
# SMTP_EMAIL_FROM=contato_senaihub@hotmail.com
# SMTP_PASS=ROTACIONAR_E_COLOCAR_APENAS_NO_BACKEND
# CLOUDINARY_API_KEY=COLE_AQUI
# CLOUDINARY_API_SECRET=COLE_AQUI
# SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_APENAS_EDGE_FUNCTIONS
